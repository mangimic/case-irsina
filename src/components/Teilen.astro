---
import { uebersetzer, type TextSchluessel } from '../i18n/texte';
import { SITE_URL } from '../config';
import { type Sprache } from '../i18n/sprachen';
import { pfadFuer, type SeitenArt } from '../i18n/routen';

interface Props {
  lang: Sprache;
  seite: SeitenArt;
  /** Ueberschrift der Leiste. */
  titelSchluessel?: TextSchluessel;
  /** Begleittext beim Teilen. Ohne Angabe wird der Seitentitel verwendet. */
  text?: string;
  /** Heller Text auf dunklem Grund (Fussbereich). */
  hell?: boolean;
}

const { lang, seite, titelSchluessel = 'shareTitle', text, hell = false } = Astro.props;
const t = uebersetzer(lang);

/* Die Adresse steht fest, weil die Seite statisch gebaut wird — geteilte Links
   zeigen deshalb immer auf die veroeffentlichte Fassung, nie auf localhost. */
const url = new URL(pfadFuer(lang, seite), SITE_URL).href;
const nachricht = text ?? t('ftitle');
const voll = `${nachricht}\n${url}`;

const ziele = [
  { k: 'wa', label: t('shWa'), href: `https://wa.me/?text=${encodeURIComponent(voll)}`,
    d: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a12 12 0 0 1-5.6-4.9c-.4-.7-.9-1.6-.9-2.5 0-.9.5-1.4.7-1.6.2-.2.4-.3.6-.3h.5c.2 0 .4 0 .6.4l.8 1.9c.1.2 0 .4-.1.5l-.4.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2 1.3 2.3 1.4.2.1.4.1.6-.1l.7-.8c.2-.2.3-.2.6-.1l1.8.9c.3.1.4.2.5.3 0 .1 0 .4-.2 1Z' },
  { k: 'fb', label: t('shFb'), href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
    d: 'M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.5 2.9h-2.3v7A10 10 0 0 0 22 12Z' },
  { k: 'tg', label: t('shTg'), href: `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(nachricht)}`,
    d: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.6 6.9-1.5 7.3c-.1.5-.4.6-.9.4l-2.4-1.8-1.2 1.1c-.1.1-.3.3-.5.3l.2-2.5 4.5-4.1c.2-.2 0-.3-.3-.1l-5.6 3.5-2.4-.8c-.5-.2-.5-.5.1-.8l9.4-3.6c.4-.2.8.1.6.9Z' },
  { k: 'xx', label: t('shX'), href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(nachricht)}`,
    d: 'M18.2 2H21l-6.5 7.4L22.2 22h-6l-4.7-6.2L6.1 22H3.3l7-8L1.8 2h6.2l4.3 5.7L18.2 2Zm-1 18.3h1.6L7 3.6H5.3l11.9 16.7Z' },
  { k: 'ml', label: t('shMail'), href: `mailto:?subject=${encodeURIComponent(t('shSubject'))}&body=${encodeURIComponent(voll)}`,
    d: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 8L4.4 7.2 4 7v11h16V7l-.4.2L12 13Zm0-1.8L19.4 6H4.6L12 11.2Z' },
] as const;

/* Kein href: ein Klick kopiert erst den Link und oeffnet dann die App. */
const sozial = [
  {
    k: 'ig', label: t('shIg'), app: 'Instagram', ziel: 'https://www.instagram.com/',
    d: 'M12 2c2.7 0 3 0 4.1.1 1.1 0 1.8.2 2.4.5.7.2 1.2.6 1.7 1.1.5.5.9 1 1.1 1.7.3.6.5 1.3.5 2.4.1 1.1.1 1.4.1 4.2s0 3.1-.1 4.2c0 1.1-.2 1.8-.5 2.4a4.6 4.6 0 0 1-1.1 1.7c-.5.5-1 .9-1.7 1.1-.6.3-1.3.5-2.4.5-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-1.1 0-1.8-.2-2.4-.5a4.6 4.6 0 0 1-1.7-1.1 4.6 4.6 0 0 1-1.1-1.7c-.3-.6-.5-1.3-.5-2.4C2 15.1 2 14.8 2 12s0-3.1.1-4.2c0-1.1.2-1.8.5-2.4.2-.7.6-1.2 1.1-1.7.5-.5 1-.9 1.7-1.1.6-.3 1.3-.5 2.4-.5C8.9 2 9.2 2 12 2Zm0 1.8c-2.7 0-3 0-4 .1-1 0-1.5.2-1.9.3-.5.2-.8.4-1.1.7-.3.3-.5.6-.7 1.1-.1.4-.3.9-.3 1.9-.1 1-.1 1.3-.1 4s0 3 .1 4c0 1 .2 1.5.3 1.9.2.5.4.8.7 1.1.3.3.6.5 1.1.7.4.1.9.3 1.9.3 1 .1 1.3.1 4 .1s3 0 4-.1c1 0 1.5-.2 1.9-.3.5-.2.8-.4 1.1-.7.3-.3.5-.6.7-1.1.1-.4.3-.9.3-1.9.1-1 .1-1.3.1-4s0-3-.1-4c0-1-.2-1.5-.3-1.9a2.9 2.9 0 0 0-.7-1.1 2.9 2.9 0 0 0-1.1-.7c-.4-.1-.9-.3-1.9-.3-1-.1-1.3-.1-4-.1Zm0 3.1a5.1 5.1 0 1 1 0 10.2 5.1 5.1 0 0 1 0-10.2Zm0 1.8a3.3 3.3 0 1 0 0 6.6 3.3 3.3 0 0 0 0-6.6Zm5.3-3.2a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z',
  },
  {
    k: 'tt', label: t('shTt'), app: 'TikTok', ziel: 'https://www.tiktok.com/',
    d: 'M16.6 2c.3 2 1.4 3.4 3.4 3.5v2.4c-1.2.1-2.3-.3-3.5-1v6.3c0 5.9-6.4 7.7-9 3.5-1.7-2.7-.6-7.4 4.7-7.6v2.6c-.4.1-.8.2-1.2.3-1.2.4-1.9 1.2-1.7 2.5.3 2.6 5.1 3.4 4.7-1.8V2h2.6Z',
  },
] as const;
---
{/*
  Instagram und TikTok nehmen — anders als WhatsApp, Facebook oder Telegram —
  keinen vorbereiteten Link entgegen; es gibt dafuer schlicht keine Adresse.
  Der ehrliche Weg ist deshalb: Link kopieren, App oeffnen, einfuegen. Auf dem
  Handy fuehrt der systemweite Teilen-Knopf ohnehin direkt in beide Apps.
*/}
<div class="share" style={hell ? 'border-top-color:rgba(255,255,255,.16)' : undefined}>
  <h2 style={hell ? 'color:#b6a794' : undefined}>{t(titelSchluessel)}</h2>
  <ul class="sh-row">
    {ziele.map((z) => (
      <li>
        <a
          class={`sh ${z.k}`}
          href={z.href}
          target="_blank"
          rel="noopener noreferrer"
          style={hell ? 'background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.2);color:#f2e9dc' : undefined}
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={z.d} /></svg>
          {z.label}
        </a>
      </li>
    ))}
    {sozial.map((z) => (
      <li>
        <button
          class={`sh js-only ${z.k}`}
          type="button"
          data-app={z.app}
          data-ziel={z.ziel}
          data-url={url}
          data-hinweis={t('shEinfuegen', { app: z.app })}
          style={hell ? 'background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.2);color:#f2e9dc' : undefined}
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={z.d} /></svg>
          {z.label}
        </button>
      </li>
    ))}
    <li>
      <button
        class="sh js-only kopieren"
        type="button"
        data-url={url}
        data-ok={t('shCopied')}
        style={hell ? 'background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.2);color:#f2e9dc' : undefined}
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1Zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2Zm0 16H8V7h11v14Z" /></svg>
        {t('shCopy')}
      </button>
    </li>
    <li>
      <button
        class="sh teilen-nativ"
        type="button"
        hidden
        data-titel={nachricht}
        data-url={url}
        style={hell ? 'background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.2);color:#f2e9dc' : undefined}
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 16a3 3 0 0 0-2 .8l-7-4a3 3 0 0 0 0-1.6l7-4A3 3 0 1 0 15 5l-7 4a3 3 0 1 0 0 6l7 4A3 3 0 1 0 18 16Z" /></svg>
        {t('shNative')}
      </button>
    </li>
  </ul>
</div>

<script>
  function melden(text: string, dauer = 2200) {
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = text;
    toast.classList.add('on');
    window.setTimeout(() => toast.classList.remove('on'), dauer);
  }

  // Instagram und TikTok: Link in die Zwischenablage, dann die App oeffnen.
  // Ein fertiger Teilen-Link existiert bei beiden nicht, deshalb der Hinweis.
  document.querySelectorAll<HTMLButtonElement>('.sh.ig, .sh.tt').forEach((knopf) => {
    knopf.addEventListener('click', async () => {
      const url = knopf.dataset.url ?? location.href;
      try {
        await navigator.clipboard.writeText(url);
        /* Laenger stehen lassen: der Hinweis ist ein ganzer Satz. */
        melden(knopf.dataset.hinweis ?? '', 5000);
      } catch {
        window.prompt(knopf.dataset.hinweis ?? '', url);
      }
      // Erst nach dem Kopieren, sonst verliert die Seite vorher den Fokus.
      window.setTimeout(() => {
        window.open(knopf.dataset.ziel, '_blank', 'noopener,noreferrer');
      }, 400);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.sh.kopieren').forEach((knopf) => {
    knopf.addEventListener('click', async () => {
      const url = knopf.dataset.url ?? location.href;
      try {
        await navigator.clipboard.writeText(url);
        melden(knopf.dataset.ok ?? 'OK');
      } catch {
        window.prompt(knopf.textContent?.trim() ?? '', url);
      }
    });
  });

  // Systemweites Teilen gibt es fast nur auf Mobilgeraeten — der Knopf
  // erscheint deshalb erst, wenn der Browser es wirklich kann.
  if (typeof navigator.share === 'function') {
    document.querySelectorAll<HTMLButtonElement>('.sh.teilen-nativ').forEach((knopf) => {
      knopf.hidden = false;
      knopf.addEventListener('click', () => {
        navigator
          .share({ title: knopf.dataset.titel, text: knopf.dataset.titel, url: knopf.dataset.url })
          .catch(() => {});
      });
    });
  }
</script>
